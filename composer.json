{
    "name": "ernestdefoe/kiosk",
    "description": "Kiosk — sell anything on your Flarum forum: memberships, premium tags, single discussions, posting passes, tips, and whatever other extensions make sellable (Atrium albums, Social Groups, Syllabus courses). PayPal, Stripe and crypto. Set up in minutes.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "payments",
        "paypal",
        "memberships",
        "subscriptions",
        "paywall",
        "premium",
        "store"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/kiosk",
    "support": {
        "issues": "https://github.com/ernestdefoe/kiosk/issues",
        "source": "https://github.com/ernestdefoe/kiosk"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/tags": "Sell access to tags: premium sections only paying members can see.",
        "ernestdefoe/velvet-rope": "Show a teaser of paid content with a Buy button instead of hiding it."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Kiosk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\Kiosk\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Kiosk",
            "category": "feature",
            "icon": {
                "name": "fas fa-store",
                "backgroundColor": "#b45309",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/tags"
            ]
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
